# Kynovar path configuration.
# Leave a variable empty to use the default under the repository root.
# Do not hardcode a machine-specific volume name in committed config.
# Startup validation rejects project paths outside the repository
# unless they sit under an explicit KYNOVAR_DATA_ROOT.

# Absolute path to this repository. Default: directory that contains pyproject.toml.
KYNOVAR_ROOT=

# Optional container for data/checkpoints/results if they should not use the defaults.
# KYNOVAR_DATA_ROOT=

# Defaults: <KYNOVAR_ROOT>/datasets, checkpoints, results, logs
KYNOVAR_DATA=
KYNOVAR_CHECKPOINTS=
KYNOVAR_RESULTS=
KYNOVAR_LOGS=

# Process-local caches. Startup points these at <KYNOVAR_ROOT>/.cache/...
# so model and dataset downloads stay on the project drive.
HF_HOME=
TORCH_HOME=
XDG_CACHE_HOME=
